{
  "name": "sostituto",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Assistente local de composição musical (Claude Code + vault em markdown/MIDI)",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "vite build",
    "start": "vite build && tsx server/src/index.ts",
    "stop": "node scripts/stop.mjs",
    "restart": "node scripts/stop.mjs && npm start",
    "login:codex": "node scripts/login.mjs codex",
    "login:kimi": "node scripts/login.mjs kimi",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p web"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.311",
    "@fastify/static": "^10.1.8",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@moonshot-ai/kimi-code": "^2.3.3",
    "@openai/codex-sdk": "^0.165.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fastify": "^5.12.7",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^7.0.2"
  }
}
